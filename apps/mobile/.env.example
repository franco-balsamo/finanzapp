# Copiar a .env (no se commitea).
# Local: los valores de `npx supabase status` (API_URL y PUBLISHABLE_KEY).
# Proyecto mangos: la URL del proyecto y la publishable key. Nunca la service role.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Dónde está publicada la web de invitados (W-2): arma los links de "Compartir link".
# Local: http://localhost:8081. Producción: la URL del proyecto en Vercel (o el dominio, cuando esté).
EXPO_PUBLIC_WEB_URL=http://localhost:8081
